# Local development uses a backend-generated one-time arithmetic challenge.
# Production must use server-verified Cloudflare Turnstile.
CAPTCHA_MODE=local
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
PORT=5174

# Admin panel login. Use a unique password with at least 16 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Gmail SMTP (use a Google App Password; never commit your real .env file).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@gmail.com
SMTP_PASSWORD=
SMTP_FROM="NNB Academy <hello@gmail.com>"
